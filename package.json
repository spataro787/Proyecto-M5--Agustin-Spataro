{
  "name": "github-mcp-server",
  "version": "1.0.0",
  "description": "MCP server en Node.js/TypeScript para automatizar operaciones de GitHub desde Antigravity.",
  "main": "dist/server.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
